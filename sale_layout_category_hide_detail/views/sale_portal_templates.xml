<odoo>
  <template
        id="sale_order_portal_content_hide_detail"
        inherit_id="sale.sale_order_portal_content"
        priority="9999"
    >
    <xpath
            expr='//tbody[hasclass("sale_tbody")]//t[@t-if="line.display_type == &apos;line_section&apos;"]//td'
            position="replace"
        >
        <t t-if="line.product_uom_qty or line.price_unit">
            <td name="td_section_line">
                <span t-field="line.name" />
            </td>
            <td name="td_quantity" class="text-right">
                <span t-field="line.product_uom_qty" />
            </td>
            <t t-if="not line.price_unit">
                <t t-set="current_subtotal_item" t-value="0" />
                <t t-set="last_section_id" t-value="0" />
                <t t-foreach="sale_order.order_line" t-as="line2">
                    <t t-if="not line2.display_type and last_section_id==line.id">
                        <t
                                t-set="current_subtotal_item"
                                t-value="current_subtotal_item + line2.price_subtotal"
                                groups="account.group_show_line_subtotals_tax_excluded"
                            />
                        <t
                                t-set="current_subtotal_item"
                                t-value="current_subtotal_item + line2.price_total"
                                groups="account.group_show_line_subtotals_tax_included"
                            />
                    </t>
                    <t t-if="line2.display_type == 'line_section'">
                        <t t-set="last_section_id" t-value="line2.id" />
                    </t>
                </t>
            </t>
            <td name="td_priceunit" class="text-right">
                <span t-field="line.price_unit" t-if="line.price_unit" />
                <span
                        t-esc="current_subtotal_item/line.product_uom_qty"
                        t-if="not line.price_unit"
                    />
            </td>
            <td name="empty" colspan="99" />
        </t>
        <t t-else="">
            <td colspan="99">
                <span t-field="line.name" />
            </td>
        </t>
    </xpath>
    <xpath
            expr="//tbody[hasclass('sale_tbody')]//t[@t-if='not line.display_type']"
            position="attributes"
        >
      <attribute
                name="t-if"
                add="(not current_section or current_section.show_details)"
                separator=" and "
            />
    </xpath>
    <xpath
            expr='//tbody[hasclass("sale_tbody")]//t[@t-if="line.display_type == &apos;line_section&apos;"]//td'
            position="attributes"
        >
      <attribute name="t-if" add="line.show_details" separator=" and " />
    </xpath>
    <xpath
            expr='//tbody[hasclass("sale_tbody")]//t[@t-if="line.display_type == &apos;line_note&apos;"]//td'
            position="attributes"
        >
      <attribute
                name="t-if"
                add="(not current_section or current_section.show_details)"
                separator=" and "
            />
    </xpath>
    <xpath
            expr="//tbody[hasclass('sale_tbody')]//tr[hasclass('is-subtotal', 'text-right')]"
            position="attributes"
        >
      <attribute
                name="t-if"
                add="current_section.show_details and current_section.show_subtotal"
                separator=" and "
            />
    </xpath>
    <xpath
            expr="//tbody[hasclass('sale_tbody')]//tr[hasclass('is-subtotal', 'text-right')]/td/strong"
            position="attributes"
        >
      <attribute name="class" add="d-none" separator=" " />
    </xpath>
    <xpath
            expr="//tbody[hasclass('sale_tbody')]//tr[hasclass('is-subtotal', 'text-right')]/td/strong"
            position="after"
        >
      <strong class="mr16">Subtotal</strong>
    </xpath>
    <xpath
            expr="//tbody[hasclass('sale_tbody')]//tr[hasclass('is-subtotal', 'text-right')]"
            position="after"
        >
      <t t-if="not current_section.show_details">
        <tr class="bg-200 o_line_section">
          <td colspan="99">
            <span t-field="current_section.name" class="font-weight-bold" />
            <span class="float-right">
              <span
                                t-if="current_section.show_section_subtotal"
                                class="float-right"
                                t-esc="current_subtotal"
                                t-options='{"widget": "monetary", "display_currency": sale_order.pricelist_id.currency_id}'
                            />
            </span>
          </td>
        </tr>
      </t>
    </xpath>

    <!-- Prices -->
    <xpath expr="//div[@t-field='line.price_unit']" position="attributes">
        <attribute
                name="t-if"
                add="not current_section or current_section.show_line_amount"
                separator=" and "
            />
      </xpath>
      <xpath expr="//span[@t-field='line.price_subtotal']" position="attributes">
        <attribute
                name="t-if"
                add="not current_section or current_section.show_line_amount"
                separator=" and "
            />
      </xpath>
      <xpath expr="//span[@t-field='line.price_total']" position="attributes">
        <attribute
                name="t-if"
                add="not current_section or current_section.show_line_amount"
                separator=" and "
            />
      </xpath>
      <xpath
            expr="//t[@t-foreach='sale_order.order_line']//span[contains(@t-esc, 'line.tax_id')]"
            position="attributes"
        >
        <attribute
                name="t-if"
                add="not current_section or current_section.show_line_amount"
                separator=" and "
            />
      </xpath>

  </template>
</odoo>
